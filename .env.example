# ══════════════════════════════════════════════════════════════════════════════
#  Vayunandhan Crafts — Environment Configuration Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Django Core ────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite is used by default (leave DB_ENGINE blank for local dev).
# Uncomment and fill in the MySQL settings for production.

# DB_ENGINE=django.db.backends.mysql
# DB_NAME=vayunandhan_db
# DB_USER=db_user
# DB_PASSWORD=db_password
# DB_HOST=localhost
# DB_PORT=3306

# ── Razorpay ───────────────────────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp Business Cloud API ────────────────────────────────────────────────
# Get these from https://developers.facebook.com → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Email (SMTP) ────────────────────────────────────────────────────────────────
# For local dev use console backend (emails print to terminal):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For production (Gmail example):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Vayunandhan Crafts <noreply@vayunandhan.com>

# ── Store Settings ──────────────────────────────────────────────────────────────
STORE_NAME=Vayunandhan Crafts
STORE_EMAIL=hello@vayunandhan.com
STORE_PHONE=+91XXXXXXXXXX
# WhatsApp number with country code, no + or spaces e.g. 919876543210
STORE_WHATSAPP_NUMBER=91XXXXXXXXXX
STORE_UPI_ID=yourname@upi
STORE_INSTAGRAM=https://www.instagram.com/vayunandhan_crafts
STORE_FACEBOOK=
